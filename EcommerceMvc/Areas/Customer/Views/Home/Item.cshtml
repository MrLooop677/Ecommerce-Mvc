@using EcommerceMvc.ViewModel
@model ProductWithRelatedVM
<!-- Product section -->
<section class="py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="row gx-4 gx-lg-5 align-items-center">

            <!-- Main Product Image -->
            <div class="col-md-6">
                <img class="card-img-top mb-5 mb-md-0"
                     src="~/images/@Model.product.MainImage"
                     alt="Product Image">
            </div>

            <!-- Main Product Details -->
            <div class="col-md-6">
                <div class="small mb-1">
                    Category Name: @Model.product.Category.Name
                </div>

                <h1 class="display-5 fw-bolder">
                    @Model.product.Name
                </h1>

                <!-- Price -->
                <div class="fs-5 mb-5">
                    @if (Model.product.Discount > 0)
                    {
                        <span class="text-decoration-line-through">
                            @Model.product.Price.ToString("C")
                        </span>

                        <span>
                            @((Model.product.Price -
                                (Model.product.Price * Model.product.Discount / 100))
                                .ToString("C"))
                        </span>
                    }
                    else
                    {
                        <span>
                            @Model.product.Price.ToString("C")
                        </span>
                    }
                </div>

                <!-- Description -->
                <p class="lead">
                    Lorem ipsum dolor sit amet consectetur adipisicing elit.
                    Praesentium at dolorem quidem modi. Nam sequi consequatur
                    obcaecati excepturi alias magni, accusamus eius blanditiis
                    delectus ipsam minima ea iste laborum vero?
                </p>

                <!-- Add to Cart -->
                <div class="d-flex">
                    <form action="Item" method="post">
                        <input type="hidden"
                               name="productId"
                               value="@Model.product.ID">

                        <input class="form-control text-center me-3"
                               id="inputQuantity"
                               type="number"
                               value="1"
                               name="count"
                               min="1"
                               style="max-width: 5rem">

                        <button class="btn btn-outline-dark flex-shrink-0 mt-3"
                                type="submit">
                            <i class="bi-cart-fill me-1"></i>
                            Add to cart
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- Related Products Section -->
<section class="py-5 bg-light">
    <div class="container px-4 px-lg-5 mt-5">

        <h2 class="fw-bolder mb-4">
            Related products
        </h2>

        <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">

            @foreach (var item in Model.relatedProducts)
            {
                <div class="col mb-5">
                    <div class="card h-100">

                        <div class="badge bg-dark text-white position-absolute"
                             style="top: 0.5rem; right: 0.5rem">
                            @(item.Discount > 0 ? "Sale" : "New")
                        </div>

                        <img class="card-img-top"
                             src="~/images/@item.MainImage"
                             alt="Product Image">

                        <div class="card-body p-4">
                            <div class="text-center">

                                <h5 class="fw-bolder">
                                 Name:   @item.Name
                                </h5>
                                <h5 class="fw-bolder">
                                 category:   @item.Category.Name
                                </h5>

                                <!-- Rating -->
                                <div class="star-rating animated-stars">

                                    @for (int i = @item.Rate; i > 0; i--)
                                    {
                                        <label class="bi bi-star-fill"></label>
                                    }2

                                </div>

                                <!-- Price -->
                                @if (item.Discount > 0)
                                {
                                    <span class="text-decoration-line-through">
                                        @item.Price.ToString("C")
                                    </span>

                                    <span>
                                        @((item.Price -
                                            (item.Price * item.Discount / 100))
                                            .ToString("C"))
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        @item.Price.ToString("C")
                                    </span>
                                }

                            </div>
                        </div>

                        <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                            <div class="text-center">
                                <a class="btn btn-outline-dark mt-auto"
                                   href="#">
                                    Add to cart
                                </a>
                            </div>
                        </div>

                    </div>
                </div>

            
            }

           

        </div>
    </div>
</section>